---
// "Power line": a phosphor circuit trace that weaves through the homepage
// layout — built at runtime from the real element positions. As the draw head
// passes elements they "power on" (.traced), nodes light up at touch points,
// background splotches bloom, and a glowing packet glides along the path.
// Line + nodes + card tracing are desktop-only (≥1280px); the ambient
// splotches run at every width. Static fully-lit under prefers-reduced-motion.
---

<div class="splotches" id="trace-splotches" aria-hidden="true"></div>
<div class="rail" id="scroll-rail" aria-hidden="true">
  <svg preserveAspectRatio="none">
    <path class="trace base"></path>
    <path class="trace glow"></path>
  </svg>
  <span class="packet"></span>
</div>

<style>
  .rail,
  .splotches {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  /* visibility (not display): the path must stay measurable for
     getTotalLength() even when the line is hidden on narrow screens.
     1200px is the narrowest width where the margin lanes still fit. */
  @media (max-width: 1199px) {
    .rail {
      visibility: hidden;
    }
  }

  .rail svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .trace {
    fill: none;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .base {
    stroke: var(--line);
    stroke-width: 1.5;
  }

  .glow {
    stroke: var(--acc);
    stroke-width: 2.25;
    opacity: 0.9;
    filter: drop-shadow(0 0 4px var(--acc-glow)) drop-shadow(0 0 14px rgba(198, 242, 78, 0.18));
    stroke-dasharray: 0 99999;
  }

  .packet {
    position: absolute;
    top: 0;
    left: 0;
    width: 9px;
    height: 9px;
    margin: -4.5px 0 0 -4.5px;
    background: var(--acc);
    box-shadow:
      0 0 12px var(--acc-glow),
      0 0 28px rgba(198, 242, 78, 0.25);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  :global(.trace-node) {
    position: absolute;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: var(--ink-900);
    transform: translate(-50%, -50%);
    transition:
      background-color 0.35s ease,
      border-color 0.35s ease,
      box-shadow 0.35s ease;
  }

  :global(.trace-node.lit) {
    background: var(--acc);
    border-color: var(--acc);
    box-shadow: 0 0 12px var(--acc-glow);
  }

  :global(.trace-node.terminal.lit) {
    animation: pulse-dot 2.2s ease-out infinite;
  }

  /* opacity + scale are driven per-frame from the line's head position
     (continuous with scroll), so no CSS transition here */
  :global(.splotch) {
    position: absolute;
    transform: translate(-50%, -50%) scale(0.75);
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(198, 242, 78, 0.23) 0%,
      rgba(198, 242, 78, 0.08) 45%,
      transparent 72%
    );
    opacity: 0;
  }
</style>

<script>
  const rail = document.getElementById('scroll-rail')
  const splotchBox = document.getElementById('trace-splotches')
  const page = rail?.parentElement

  if (rail && splotchBox && page) {
    const svg = rail.querySelector('svg') as SVGSVGElement
    const base = rail.querySelector('.base') as SVGPathElement
    const glow = rail.querySelector('.glow') as SVGPathElement
    const packet = rail.querySelector('.packet') as HTMLElement
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches
    const isWide = () => matchMedia('(min-width: 1200px)').matches

    const $ = (sel: string) => document.querySelector<HTMLElement>(sel)
    const $$ = (sel: string) => [...document.querySelectorAll<HTMLElement>(sel)]

    // page-coordinate rect helper
    const pageRect = (el: Element) => {
      const r = el.getBoundingClientRect()
      const pr = page.getBoundingClientRect()
      return {
        left: r.left - pr.left,
        right: r.right - pr.left,
        top: r.top - pr.top,
        bottom: r.bottom - pr.top,
        cx: r.left - pr.left + r.width / 2,
        cy: r.top - pr.top + r.height / 2,
        w: r.width,
        h: r.height,
      }
    }

    // orthogonal polyline -> rounded-corner SVG path
    const roundedPath = (raw: { x: number; y: number }[], r = 22) => {
      // drop consecutive (near-)identical points — degenerate segments divide
      // by zero (happens e.g. when grid gutters coincide in 1-column layouts)
      const pts = [raw[0]]
      for (const p of raw.slice(1)) {
        const q = pts[pts.length - 1]
        if (Math.hypot(p.x - q.x, p.y - q.y) > 0.5) pts.push(p)
      }
      if (pts.length < 2) return ''
      let d = `M${pts[0].x.toFixed(1)} ${pts[0].y.toFixed(1)}`
      for (let i = 1; i < pts.length - 1; i++) {
        const p = pts[i - 1]
        const c = pts[i]
        const n = pts[i + 1]
        const dIn = Math.hypot(c.x - p.x, c.y - p.y)
        const dOut = Math.hypot(n.x - c.x, n.y - c.y)
        const rr = Math.min(r, dIn / 2, dOut / 2)
        const e1 = { x: c.x + ((p.x - c.x) / dIn) * rr, y: c.y + ((p.y - c.y) / dIn) * rr }
        const e2 = { x: c.x + ((n.x - c.x) / dOut) * rr, y: c.y + ((n.y - c.y) / dOut) * rr }
        d += ` L${e1.x.toFixed(1)} ${e1.y.toFixed(1)} Q${c.x.toFixed(1)} ${c.y.toFixed(1)} ${e2.x.toFixed(1)} ${e2.y.toFixed(1)}`
      }
      const last = pts[pts.length - 1]
      d += ` L${last.x.toFixed(1)} ${last.y.toFixed(1)}`
      return d
    }

    // ---- state rebuilt on layout changes ----
    let xs = new Float32Array(0) // sampled path points
    let ys = new Float32Array(0)
    let ss = new Float32Array(0) // cumulative length at each sample
    let total = 0
    let nodes: { el: HTMLElement; y: number }[] = []
    let splotches: { el: HTMLElement; y: number; k: number }[] = []
    let traced: {
      el: HTMLElement
      y: number
      rampStart: number
      rampEnd: number
      heading: boolean
      k: number
    }[] = []
    let built = false

    const buildGeometry = () => {
      built = false
      nodes.forEach((n) => n.el.remove())
      splotches.forEach((s) => s.el.remove())
      nodes = []
      splotches = []
      traced = []

      const pr = page.getBoundingClientRect()
      svg.setAttribute('viewBox', `0 0 ${pr.width} ${pr.height}`)

      const chip = $('.status')
      const featured = $$('.featured-stack .card')
      const grid = $$('.grid > .card')
      const xp = $('.xp')
      const photo = $('.xp-photo')
      const contact = $('.contact')
      const btn = $('.contact .btn-solid')
      const container = $('#projects > .container')
      const headings = $$('.section-heading')
      if (!chip || featured.length < 2 || grid.length < 6 || !xp || !photo || !btn || !container || !contact) return

      const C = pageRect(container)
      const xL = C.left - 26
      const xR = C.right + 26
      const rChip = pageRect(chip)
      const A = pageRect(featured[0])
      const B = pageRect(featured[1])
      const g = grid.map(pageRect)
      const rXp = pageRect(xp)
      const rPhoto = pageRect(photo)
      const rBtn = pageRect(btn)

      // the trace grows out of the hero fractal's root when present
      const fractal = $('#hero-fractal')
      let p0 = { x: rChip.cx, y: rChip.top - 30 }
      if (fractal && getComputedStyle(fractal).display !== 'none') {
        const fr = pageRect(fractal)
        p0 = {
          x: fr.left + fr.w * Number(fractal.dataset.rootX || 0.06),
          y: fr.top + fr.h * Number(fractal.dataset.rootY || 0.98),
        }
      }

      const gut1 = (g[0].right + g[1].left) / 2
      const gut2 = (g[4].right + g[5].left) / 2
      const gutXp = (rXp.right + rPhoto.left) / 2
      const gapHero = (rChip.bottom + A.top) / 2
      const gap1 = (A.bottom + B.top) / 2
      const gap2 = (B.bottom + g[0].top) / 2
      const gapRow = (g[0].bottom + g[3].top) / 2
      const xpEnter = rXp.top - 24
      const xpExit = rXp.bottom + 26

      const pts = [
        p0,
        { x: p0.x, y: rChip.cy },
        { x: rChip.right + 14, y: rChip.cy }, // tap the status chip on the way
        { x: rChip.right + 14, y: gapHero },
        { x: xL, y: gapHero },
        { x: xL, y: gap1 },
        { x: xR, y: gap1 }, // full-width sweep between the featured cards
        { x: xR, y: gap2 },
        { x: gut1, y: gap2 }, // into the first grid gutter
        { x: gut1, y: gapRow },
        { x: gut2, y: gapRow }, // jog to the second gutter
        { x: gut2, y: xpEnter },
        { x: gutXp, y: xpEnter }, // slide between the xp card and the photo
        { x: gutXp, y: xpExit },
        { x: xL, y: xpExit },
        { x: xL, y: rBtn.cy },
        { x: rBtn.left - 14, y: rBtn.cy }, // terminal at the email button
      ]

      const d = roundedPath(pts)
      base.setAttribute('d', d)
      glow.setAttribute('d', d)

      // sample the path once; per-frame work is just table lookups
      total = glow.getTotalLength()
      const N = 700
      xs = new Float32Array(N + 1)
      ys = new Float32Array(N + 1)
      ss = new Float32Array(N + 1)
      for (let i = 0; i <= N; i++) {
        const s = (i / N) * total
        const p = glow.getPointAtLength(s)
        xs[i] = p.x
        ys[i] = p.y
        ss[i] = s
      }

      // touch nodes at the points where the line passes each element
      const nodeSpots = [
        { x: rChip.right + 14, y: rChip.cy },
        { x: xL, y: A.cy },
        { x: xR, y: B.cy },
        { x: gut1, y: g[0].cy },
        { x: gut2, y: g[3].cy },
        { x: gutXp, y: rXp.cy },
        { x: rBtn.left - 14, y: rBtn.cy, terminal: true },
      ]
      for (const spot of nodeSpots) {
        const el = document.createElement('span')
        el.className = 'trace-node' + (spot.terminal ? ' terminal' : '')
        el.style.left = `${spot.x}px`
        el.style.top = `${spot.y}px`
        rail.appendChild(el)
        nodes.push({ el, y: spot.y })
      }

      // ambient background splotches — vertically centered ON each content
      // row so the glow lines up with the cards, horizontally placed in the
      // margins/gutters where the line runs so the bright core stays visible
      const splotchSpots = [
        { x: Math.max(30, C.left - 60), y: A.cy, size: 920 },
        { x: Math.min(pr.width - 30, C.right + 60), y: B.cy, size: 880 },
        { x: (C.left + C.right) / 2, y: gapRow, size: 1100 },
        { x: gutXp, y: rXp.cy, size: 820 },
        { x: C.left + C.w * 0.55, y: rBtn.cy, size: 840 },
      ]
      for (const spot of splotchSpots) {
        const el = document.createElement('span')
        el.className = 'splotch'
        el.style.left = `${spot.x}px`
        el.style.top = `${spot.y}px`
        el.style.width = `${spot.size}px`
        el.style.height = `${spot.size}px`
        splotchBox.appendChild(el)
        splotches.push({ el, y: spot.y, k: -1 })
      }

      // elements that power on as the head passes their center. Headings
      // toggle a class; everything else gets a continuous --lit (0→1) ramp
      // so the glow fades in with the scroll instead of popping.
      const targets = [...featured, ...grid, xp, photo, contact, ...headings]
      traced = targets.map((el) => {
        const r = pageRect(el)
        return {
          el,
          y: r.top + r.h * 0.45,
          // glow ramps from just above the element's top edge and reaches
          // full brightness when the head is halfway past it
          rampStart: r.top - 40,
          rampEnd: r.top + r.h * 0.5,
          heading: el.classList.contains('section-heading'),
          k: -1,
        }
      })

      built = true
    }

    // binary search: first sample index with ys[i] >= y
    const lowerBound = (y: number) => {
      let lo = 0
      let hi = ys.length - 1
      while (lo < hi) {
        const mid = (lo + hi) >> 1
        if (ys[mid] < y) lo = mid + 1
        else hi = mid
      }
      return lo
    }

    let sShown = 0
    let raf = 0
    const frame = () => {
      raf = 0
      if (!built) return
      const pr = page.getBoundingClientRect()
      const pageTop = pr.top + window.scrollY
      let frontier = window.scrollY + window.innerHeight * 0.72 - pageTop
      // at the very bottom of the document the trace completes fully, so the
      // terminal node (below the deepest reachable frontier) still lights
      const maxScroll = document.documentElement.scrollHeight - window.innerHeight
      if (window.scrollY >= maxScroll - 2) frontier = pr.height

      const wide = isWide()
      // narrow screens have no line: light from the scroll frontier instead
      let lightY = frontier

      if (wide) {
        const sTarget = frontier <= ys[0] ? 0 : ss[lowerBound(Math.min(frontier, ys[ys.length - 1]))]
        sShown += (sTarget - sShown) * 0.16
        if (Math.abs(sTarget - sShown) < 0.6) sShown = sTarget
        glow.style.strokeDasharray = `${sShown} ${total + 100}`
        const i = Math.min(xs.length - 1, Math.round((sShown / total) * (xs.length - 1)))
        packet.style.transform = `translate(${xs[i]}px, ${ys[i]}px)`
        packet.style.opacity = sShown > 2 && sShown < total - 2 ? '1' : '0'
        // things light when the visible draw head reaches them, so the
        // power-on cascade trails the line as it eases along the path
        lightY = ys[i]
        for (const n of nodes) n.el.classList.toggle('lit', lightY >= n.y - 4)
        if (sShown !== sTarget) queue()
      } else {
        packet.style.opacity = '0'
      }

      // splotches bloom continuously with the head's approach: a 320px ramp
      // that completes exactly when the head reaches the splotch center
      for (const s of splotches) {
        const lin = Math.max(0, Math.min(1, (lightY - (s.y - 320)) / 320))
        const k = lin * lin * (3 - 2 * lin) // smoothstep
        if (Math.abs(k - s.k) > 0.004) {
          s.el.style.opacity = k.toFixed(3)
          s.el.style.transform = `translate(-50%, -50%) scale(${(0.75 + 0.25 * k).toFixed(3)})`
          s.k = k
        }
      }
      for (const t of traced) {
        if (t.heading) {
          t.el.classList.toggle('traced', wide && lightY >= t.y - 2)
          continue
        }
        // linear progress through the ramp window, then sqrt-eased so the
        // glow is perceptible the moment the head reaches the element
        const lin = wide
          ? Math.max(0, Math.min(1, (lightY - t.rampStart) / Math.max(1, t.rampEnd - t.rampStart)))
          : 0
        const k = Math.sqrt(lin)
        if (Math.abs(k - t.k) > 0.004) {
          t.el.style.setProperty('--lit', k.toFixed(3))
          t.k = k
        }
      }
    }
    const queue = () => {
      if (!raf) raf = requestAnimationFrame(frame)
    }

    let rebuildTimer = 0
    const rebuild = () => {
      clearTimeout(rebuildTimer)
      rebuildTimer = window.setTimeout(() => {
        buildGeometry()
        if (reduced) staticLight()
        else queue()
      }, 120)
    }

    const staticLight = () => {
      if (!built) return
      glow.style.strokeDasharray = 'none'
      packet.style.opacity = '0'
      nodes.forEach((n) => n.el.classList.add('lit'))
      splotches.forEach((s) => {
        s.el.style.opacity = '1'
        s.el.style.transform = 'translate(-50%, -50%) scale(1)'
      })
      if (isWide())
        traced.forEach((t) => {
          if (t.heading) t.el.classList.add('traced')
          else t.el.style.setProperty('--lit', '1')
        })
    }

    buildGeometry()
    if (reduced) {
      staticLight()
      addEventListener('resize', rebuild, { passive: true })
    } else {
      addEventListener('scroll', queue, { passive: true })
      addEventListener('resize', rebuild, { passive: true })
      addEventListener('load', rebuild)
      new ResizeObserver(rebuild).observe(page)
      queue()
    }
  }
</script>

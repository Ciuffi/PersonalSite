---
const links = [
  { href: '/#projects', label: 'Projects' },
  { href: '/#experience', label: 'Experience' },
  { href: '/#contact', label: 'Contact' },
]
---

<header class="site-header" id="site-header">
  <div class="container header-row">
    <a class="brand" href="/" aria-label="ciuffi.dev — home">
      ciuffi.dev<span class="cursor" aria-hidden="true"></span>
    </a>
    <nav aria-label="Main">
      <ul class="nav-list">
        {
          links.map((l) => (
            <li>
              <a class="nav-link" href={l.href}>
                {l.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            class="nav-link gh"
            href="https://github.com/ciuffi"
            target="_blank"
            rel="noopener"
            aria-label="GitHub profile"
          >
            <svg width="17" height="17" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"
              ></path>
            </svg>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease;
  }

  .site-header.scrolled {
    background: rgba(10, 12, 10, 0.78);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom-color: var(--line);
  }

  .header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 1px;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    color: var(--text-hi);
  }

  .cursor {
    width: 0.55em;
    height: 1.05em;
    margin-left: 0.18em;
    background: var(--acc);
    box-shadow: 0 0 10px var(--acc-glow);
  }

  @media (prefers-reduced-motion: no-preference) {
    .cursor {
      animation: blink 1.3s steps(1) infinite;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3.5vw, 2.2rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 450;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text-mid);
    transition: color 0.15s ease;
  }

  .nav-link:hover {
    color: var(--acc);
  }

  .gh {
    display: inline-flex;
    color: var(--text-hi);
  }

  @media (max-width: 420px) {
    .nav-list {
      gap: 0.9rem;
    }

    .nav-link {
      font-size: 0.62rem;
      letter-spacing: 0.08em;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header')
  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 24)
  onScroll()
  window.addEventListener('scroll', onScroll, { passive: true })
</script>

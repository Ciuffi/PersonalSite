---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

interface Props {
  project: CollectionEntry<'projects'>
  num: number
  variant?: 'featured' | 'grid'
  delay?: number
}

const { project, num, variant = 'grid', delay = 0 } = Astro.props
const { title, description, year, tags, cover, coverAlt } = project.data
const href = `/projects/${project.id}/`
const index = `P-${String(num).padStart(2, '0')}`
---

<a
  class:list={['card', variant]}
  href={href}
  data-reveal
  style={`--reveal-delay: ${delay}ms`}
>
  {
    cover && (
      <div class="media">
        <Image
          src={cover}
          alt={coverAlt ?? `${title} preview`}
          widths={variant === 'featured' ? [480, 760, 1080] : [380, 560, 760]}
          sizes={
            variant === 'featured'
              ? '(max-width: 760px) 92vw, 640px'
              : '(max-width: 760px) 92vw, 360px'
          }
          loading={variant === 'featured' ? 'eager' : 'lazy'}
        />
      </div>
    )
  }
  <div class="body">
    <div class="meta-row">
      <span class="mono index">{index}</span>
      <span class="mono year">{year}</span>
    </div>
    <h3>{title}</h3>
    <p class="desc">{description}</p>
    <div class="tags">
      {variant === 'featured' && <span class="chip chip-acc">Featured</span>}
      {tags.map((t) => <span class="chip">{t}</span>)}
    </div>
    <span class="mono more" aria-hidden="true">Read more →</span>
  </div>
</a>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: color-mix(in srgb, var(--ink-800) 72%, transparent);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .card::before,
  .card::after {
    content: '';
    position: absolute;
    width: 14px;
    height: 14px;
    border: 0 solid var(--acc);
    opacity: 0;
    transition: opacity 0.25s ease;
    z-index: 2;
    pointer-events: none;
  }

  .card::before {
    top: 8px;
    left: 8px;
    border-top-width: 2px;
    border-left-width: 2px;
  }

  .card::after {
    bottom: 8px;
    right: 8px;
    border-bottom-width: 2px;
    border-right-width: 2px;
  }

  .card:hover {
    transform: translateY(-4px);
    border-color: var(--line-strong);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.45);
  }

  .card:hover::before,
  .card:hover::after {
    opacity: 1;
  }

  /* powered on by the scroll trace passing by: a bright flash that settles
     into a steady phosphor glow */
  .card.traced {
    border-color: rgba(198, 242, 78, 0.45);
    box-shadow: 0 0 34px -4px var(--acc-glow);
    background-image: linear-gradient(rgba(198, 242, 78, 0.05), rgba(198, 242, 78, 0.02));
    animation: power-on 0.9s ease-out;
  }

  @keyframes power-on {
    0% {
      border-color: rgba(198, 242, 78, 0.95);
      box-shadow: 0 0 58px 2px var(--acc-glow);
    }
  }

  .card.traced::before,
  .card.traced::after {
    opacity: 0.85;
  }

  .card.traced .index {
    text-shadow: 0 0 10px var(--acc-glow);
  }

  .card.traced:hover {
    border-color: rgba(198, 242, 78, 0.65);
  }

  .media {
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    aspect-ratio: 16 / 10;
    background: var(--ink-900);
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .card:hover .media :global(img) {
    transform: scale(1.03);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 1.4rem 1.5rem 1.5rem;
    flex: 1;
  }

  .meta-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .index {
    color: var(--acc);
  }

  .year {
    color: var(--text-low);
  }

  h3 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: var(--text-hi);
  }

  .desc {
    color: var(--text-mid);
    font-size: 0.95rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: auto;
    padding-top: 0.4rem;
  }

  .more {
    color: var(--text-low);
    transition: color 0.2s ease;
    padding-top: 0.5rem;
  }

  .card:hover .more {
    color: var(--acc);
  }

  /* ---- featured variant ---- */
  .featured {
    flex-direction: row;
    min-height: 340px;
  }

  .featured .media {
    flex: 1.15;
    aspect-ratio: auto;
    border-bottom: none;
    border-right: 1px solid var(--line);
  }

  .featured .body {
    flex: 1;
    padding: clamp(1.5rem, 3.5vw, 2.4rem);
    justify-content: center;
  }

  .featured h3 {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
  }

  .featured .desc {
    font-size: 1.02rem;
    -webkit-line-clamp: 4;
  }

  @media (max-width: 760px) {
    .featured {
      flex-direction: column;
      min-height: 0;
    }

    .featured .media {
      aspect-ratio: 16 / 10;
      border-right: none;
      border-bottom: 1px solid var(--line);
      flex: none;
    }
  }

  /* in the 2-col range, an orphaned last card spans both columns */
  @media (min-width: 641px) and (max-width: 980px) {
    :global(.grid) > .card.grid:last-child:nth-child(2n + 1) {
      grid-column: 1 / -1;
    }
  }

  /* an orphaned last card in a 3-col row spans the full width, laid out
     horizontally like a slim featured card */
  @media (min-width: 981px) {
    :global(.grid) > .card.grid:last-child:nth-child(3n + 1) {
      grid-column: 1 / -1;
      flex-direction: row;
      min-height: 240px;
    }

    :global(.grid) > .card.grid:last-child:nth-child(3n + 1) .media {
      flex: 1.15;
      aspect-ratio: auto;
      border-bottom: none;
      border-right: 1px solid var(--line);
    }

    :global(.grid) > .card.grid:last-child:nth-child(3n + 1) .body {
      flex: 1;
      justify-content: center;
      padding: 1.8rem 2.2rem;
    }
  }
</style>

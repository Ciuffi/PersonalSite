---
import { getCollection } from 'astro:content'
import { Image } from 'astro:assets'
import BaseLayout from '../layouts/BaseLayout.astro'
import SectionHeading from '../components/SectionHeading.astro'
import ProjectCard from '../components/ProjectCard.astro'
import ScrollRail from '../components/ScrollRail.astro'
import HeroFractal from '../components/HeroFractal.astro'
import hackathon from '../assets/hackathon.jpg'

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
)
const featured = projects.filter((p) => p.data.featured)
const rest = projects.filter((p) => !p.data.featured)

const description =
  'Giulio Rossi — software engineer at Amazon. I build games, apps, and tools: a multiplayer Roblox game, iOS apps, and AI-powered tabletop tech.'

const personLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Giulio Rossi',
  url: 'https://www.ciuffi.dev/',
  jobTitle: 'Software Engineer',
  worksFor: { '@type': 'Organization', name: 'Amazon' },
  sameAs: ['https://github.com/ciuffi'],
})
---

<BaseLayout title="Giulio Rossi — software engineer & builder" description={description}>
  <script is:inline type="application/ld+json" set:html={personLd} />

  <div class="page">
    <ScrollRail />

  <!-- ============ HERO ============ -->
  <section class="hero" id="top">
    <div class="hero-bg" aria-hidden="true"></div>
    <HeroFractal />
    <div class="container">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="mono kicker load-rise" style="--rise-delay: 0.05s">
            <span class="slashes">//</span> Software engineer & builder
          </p>
          <h1 class="load-rise" style="--rise-delay: 0.15s">Giulio Rossi</h1>
          <p class="lede load-rise" style="--rise-delay: 0.25s">
            By day I build software at Amazon. The rest of the time I ship things for
            fun — a multiplayer Roblox game, iOS apps, an Apple&nbsp;Watch game, and
            AI-powered tools for my D&amp;D table.
          </p>
          <div class="cta-row load-rise" style="--rise-delay: 0.35s">
            <a class="btn btn-solid" href="#projects">View projects ↓</a>
            <a class="btn btn-ghost" href="#contact">Get in touch</a>
            <a class="btn btn-ghost" href="/giulio-rossi-resume.pdf" target="_blank" rel="noopener">
              Resume ↗
            </a>
          </div>
          <a class="status load-rise" href="/projects/tackle-for-brainrots/" style="--rise-delay: 0.45s">
            <span class="dot" aria-hidden="true"></span>
            <span class="mono">Just launched: Tackle for Brainrots</span>
          </a>
        </div>

        <aside class="spec load-rise" style="--rise-delay: 0.4s" aria-label="Build log">
          <div class="spec-bar">
            <span class="spec-light r" aria-hidden="true"></span>
            <span class="spec-light y" aria-hidden="true"></span>
            <span class="spec-light g" aria-hidden="true"></span>
            <span class="spec-cap">~/giulio · build_log</span>
          </div>
          <dl class="spec-rows">
            <div class="spec-row">
              <dt class="spec-k">Role</dt>
              <dd class="spec-v">SWE @ Amazon</dd>
            </div>
            <div class="spec-row">
              <dt class="spec-k">Shipping since</dt>
              <dd class="spec-v">2018</dd>
            </div>
            <div class="spec-row">
              <dt class="spec-k">Latest</dt>
              <dd class="spec-v acc">Tackle for Brainrots</dd>
            </div>
            <div class="spec-row">
              <dt class="spec-k">Stack</dt>
              <dd class="spec-v stack">Java · Swift · TS · React</dd>
            </div>
          </dl>
        </aside>
      </div>
    </div>
  </section>

  <!-- ============ PROJECTS ============ -->
  <section class="section" id="projects">
    <div class="container">
      <SectionHeading
        index="01"
        title="Projects"
        sub="Selected work, 2018 → today. The two up top are what I'm building right now."
      />
      <div class="featured-stack">
        {featured.map((p, i) => <ProjectCard project={p} num={i + 1} variant="featured" delay={i * 90} />)}
      </div>
      <div class="grid">
        {rest.map((p, i) => <ProjectCard project={p} num={i + 1 + featured.length} delay={(i % 3) * 90} />)}
      </div>
    </div>
  </section>

  <!-- ============ EXPERIENCE ============ -->
  <section class="section" id="experience">
    <div class="container">
      <SectionHeading index="02" title="Experience" />
      <div class="xp-grid">
        <div class="xp" data-reveal>
          <div class="xp-row">
            <div>
              <h3 class="xp-role">Software Engineer</h3>
              <p class="xp-org">Amazon</p>
            </div>
            <span class="mono xp-dates">Jul 2021 — Present</span>
          </div>
          <div class="xp-bar" aria-hidden="true">
            <span class="xp-fill"></span>
            <span class="xp-now"></span>
          </div>
          <p class="xp-note">
            Before that: computer science at UBC, a string of hackathon wins, and
            a lot of side projects — you just scrolled past most of them.
          </p>
          <span class="glow-ring" aria-hidden="true"></span>
        </div>
        <figure class="xp-photo" data-reveal style="--reveal-delay: 90ms">
          <div class="duo">
            <Image
              src={hackathon}
              alt="Giulio helping students with their laptops in a UBC lecture hall during a hackathon"
              widths={[480, 760, 1080]}
              sizes="(max-width: 860px) 92vw, 420px"
              loading="lazy"
            />
          </div>
          <figcaption class="mono">
            nwPlus @ UBC — organizing hackathons for 1,200+ students
          </figcaption>
          <span class="glow-ring" aria-hidden="true"></span>
        </figure>
      </div>
    </div>
  </section>

  <!-- ============ CONTACT ============ -->
  <section class="section" id="contact">
    <div class="container">
      <SectionHeading index="03" title="Contact" />
      <div class="contact" data-reveal>
        <h3 class="contact-line">Let's build something.</h3>
        <p class="contact-sub">
          Want to talk about a project, a game, or just say hi? My inbox is open.
        </p>
        <div class="cta-row">
          <a class="btn btn-solid" href="mailto:ciuffi9@mac.com">Email me</a>
          <a class="btn btn-ghost" href="https://github.com/ciuffi" target="_blank" rel="noopener">
            GitHub ↗
          </a>
        </div>
      </div>
    </div>
  </section>
  </div>
</BaseLayout>

<style>
  .page {
    position: relative;
  }

  /* sections paint above the trace/splotch layers (DOM-order stacking) */
  .page > section {
    position: relative;
  }

  /* powered on by the scroll trace: --lit (0→1) fades the glow in with
     scroll via overlay rings — never tinting the surfaces or images */
  .xp,
  .xp-photo,
  .contact {
    --lit: 0;
  }

  .xp,
  .xp-photo {
    position: relative;
  }

  .xp .glow-ring,
  .xp-photo .glow-ring {
    position: absolute;
    inset: 0;
    border-radius: var(--r-lg);
    border: 1px solid rgba(198, 242, 78, 0.5);
    box-shadow: var(--glow-ring);
    opacity: var(--lit);
    pointer-events: none;
    z-index: 2;
  }

  .contact .contact-line {
    text-shadow: 0 0 26px rgba(198, 242, 78, calc(var(--lit) * 0.4));
  }

  /* ---- hero ---- */
  .hero {
    position: relative;
    padding-top: clamp(9rem, 22vh, 13rem);
    padding-bottom: clamp(4rem, 10vh, 7rem);
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(238, 242, 230, 0.1) 1px, transparent 1px);
    background-size: 34px 34px;
    -webkit-mask-image: radial-gradient(ellipse 90% 80% at 60% 0%, black 30%, transparent 75%);
    mask-image: radial-gradient(ellipse 90% 80% at 60% 0%, black 30%, transparent 75%);
  }

  .hero-bg::after {
    content: '';
    position: absolute;
    top: -240px;
    right: -160px;
    width: 640px;
    height: 640px;
    background: radial-gradient(circle, var(--acc-soft), transparent 65%);
  }

  .hero .container {
    position: relative;
  }

  /* two-column hero: copy on the left, build_log spec panel on the right */
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  /* frosted terminal "build_log" panel — floats over the fractal */
  .spec {
    position: relative;
    z-index: 1;
    align-self: center;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    backdrop-filter: var(--blur-panel);
    -webkit-backdrop-filter: var(--blur-panel);
    box-shadow: var(--shadow-panel);
    overflow: hidden;
  }

  .spec-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0.85rem 1.1rem;
    border-bottom: 1px solid var(--line);
  }

  .spec-light {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    opacity: 0.85;
  }

  .spec-light.r {
    background: #ff5f57;
  }

  .spec-light.y {
    background: #febc2e;
  }

  .spec-light.g {
    background: var(--acc);
  }

  .spec-cap {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    color: var(--text-low);
  }

  .spec-rows {
    margin: 0;
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
  }

  .spec-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-bottom: 1.05rem;
    margin-bottom: 1.05rem;
    border-bottom: 1px dashed var(--line);
  }

  .spec-row:last-child {
    padding-bottom: 0;
    margin-bottom: 0;
    border-bottom: none;
  }

  .spec-k {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-low);
  }

  .spec-v {
    margin: 0;
    text-align: right;
    color: var(--text-hi);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .spec-v.acc {
    color: var(--acc-2);
  }

  .spec-v.stack {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.85rem;
    color: var(--text-mid);
  }

  .kicker {
    color: var(--text-mid);
    margin-bottom: 1.4rem;
  }

  .slashes {
    color: var(--acc);
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 9vw, 6.6rem);
    font-weight: 750;
    letter-spacing: -0.03em;
    line-height: 0.98;
    margin-bottom: 1.6rem;
  }

  .lede {
    max-width: 56ch;
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    color: var(--text-mid);
    margin-bottom: 2.4rem;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 3.2rem;
    padding: 0.75rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    text-decoration: none;
    color: var(--text-mid);
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .status:hover {
    border-color: var(--acc);
    color: var(--text-hi);
  }

  .status .mono {
    font-size: 0.64rem;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--acc);
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .dot {
      animation: pulse-dot 2.2s ease-out infinite;
    }
  }

  /* ---- projects ---- */
  .featured-stack {
    display: grid;
    gap: 1.4rem;
    margin-bottom: 1.4rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
  }

  @media (max-width: 980px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---- experience ---- */
  .xp-grid {
    display: grid;
    grid-template-columns: 1.45fr 1fr;
    gap: 1.4rem;
    align-items: stretch;
  }

  @media (max-width: 860px) {
    .xp-grid {
      grid-template-columns: 1fr;
    }
  }

  .xp-photo {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
    background: color-mix(in srgb, var(--surface) 55%, transparent);
    margin: 0;
  }

  .duo {
    position: relative;
    flex: 1;
    min-height: 240px;
  }

  /* duotone at rest; the trace passing (--lit) restores most of the
     photo's natural color instead of adding more green on top */
  .duo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(calc(1 - var(--lit) * 0.6)) contrast(1.05)
      brightness(calc(0.85 + var(--lit) * 0.1));
    transition: filter 0.45s ease;
  }

  .duo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--acc);
    mix-blend-mode: color;
    opacity: calc(0.3 - var(--lit) * 0.18);
    pointer-events: none;
    transition: opacity 0.45s ease;
  }

  .xp-photo:hover .duo :global(img) {
    filter: none;
  }

  .xp-photo:hover .duo::after {
    opacity: 0;
  }

  .xp-photo figcaption {
    padding: 0.85rem 1.1rem;
    border-top: 1px solid var(--line);
    color: var(--text-low);
    font-size: 0.6rem;
  }

  .xp {
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: clamp(1.6rem, 4vw, 2.6rem);
    background: color-mix(in srgb, var(--surface) 55%, transparent);
  }

  .xp-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.6rem;
  }

  .xp-role {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .xp-org {
    color: var(--acc);
    font-size: 1.05rem;
    margin-top: 0.2rem;
  }

  .xp-dates {
    color: var(--text-mid);
  }

  .xp-bar {
    position: relative;
    height: 2px;
    background: var(--line);
    border-radius: 2px;
    margin-bottom: 1.6rem;
  }

  .xp-fill {
    position: absolute;
    inset: 0 6px 0 0;
    background: linear-gradient(90deg, transparent, var(--acc));
    opacity: 0.7;
  }

  .xp-now {
    position: absolute;
    right: 0;
    top: 50%;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--acc);
    transform: translateY(-50%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .xp-now {
      animation: pulse-dot 2.2s ease-out infinite;
    }
  }

  .xp-note {
    color: var(--text-low);
    max-width: 60ch;
    font-size: 0.97rem;
  }

  /* ---- contact ---- */
  .contact {
    position: relative;
    overflow: hidden;
    text-align: left;
    border: 1px solid var(--line);
    border-radius: var(--r-2xl);
    background: color-mix(in srgb, var(--surface) 60%, transparent);
    padding: clamp(2rem, 5vw, 3.4rem);
  }

  /* soft accent bloom across the top of the panel; brightens as the
     scroll trace powers the section on (--lit) */
  .contact::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 0%, var(--acc-soft), transparent 60%);
    opacity: calc(0.55 + var(--lit) * 0.45);
    pointer-events: none;
    z-index: 0;
  }

  .contact > * {
    position: relative;
    z-index: 1;
  }

  .contact-line {
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 5.5vw, 3.4rem);
    font-weight: 750;
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin-bottom: 1rem;
  }

  .contact-sub {
    color: var(--text-mid);
    margin-bottom: 2rem;
    max-width: 48ch;
  }
</style>
